rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_AUTH_UID";
    }

    match /events/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "name", "type", "date", "location", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.type in ["Market", "Shop Update"]
        && request.resource.data.date is string
        && request.resource.data.location is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner();
    }

    match /inventory/{productId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "marketId", "sku", "name", "category", "imageBase64", "price",
          "unitCost", "totalQty", "soldQty", "notes", "updatedAt"
        ])
        && request.resource.data.marketId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.marketId))
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.imageBase64 is string
        && request.resource.data.price is number
        && request.resource.data.unitCost is number
        && request.resource.data.totalQty is int
        && request.resource.data.soldQty is int
        && request.resource.data.soldQty >= 0
        && request.resource.data.soldQty <= request.resource.data.totalQty
        && request.resource.data.notes is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }
  }
}

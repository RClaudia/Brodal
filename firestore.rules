rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_AUTH_UID";
    }

    function validColorVariant(variant) {
      return variant is map
        && variant.keys().hasOnly(["id", "color", "imageBase64", "quantity"])
        && variant.id is string
        && variant.color is string
        && variant.imageBase64 is string
        && (!("quantity" in variant)
          || (variant.quantity is int && variant.quantity >= 0));
    }

    function validColorVariants(variants) {
      return variants is list
        && variants.size() > 0
        && variants.size() <= 12
        && validColorVariant(variants[0])
        && (variants.size() < 2 || validColorVariant(variants[1]))
        && (variants.size() < 3 || validColorVariant(variants[2]))
        && (variants.size() < 4 || validColorVariant(variants[3]))
        && (variants.size() < 5 || validColorVariant(variants[4]))
        && (variants.size() < 6 || validColorVariant(variants[5]))
        && (variants.size() < 7 || validColorVariant(variants[6]))
        && (variants.size() < 8 || validColorVariant(variants[7]))
        && (variants.size() < 9 || validColorVariant(variants[8]))
        && (variants.size() < 10 || validColorVariant(variants[9]))
        && (variants.size() < 11 || validColorVariant(variants[10]))
        && (variants.size() < 12 || validColorVariant(variants[11]));
    }

    function marketIsOpen(marketId) {
      let market = getAfter(/databases/$(database)/documents/events/$(marketId));
      return !("status" in market.data) || market.data.status == "open";
    }

    match /events/{eventId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "name", "type", "startDate", "endDate", "location", "organizer", "edition",
          "status", "cashIncome", "bankIncome", "totalItemsSold", "durationDays", "createdAt", "closedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.type in ["Market", "Shop Update"]
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.location is string
        && request.resource.data.organizer is string
        && request.resource.data.edition is string
        && request.resource.data.status in ["open", "closed"]
        && request.resource.data.cashIncome is number
        && request.resource.data.cashIncome >= 0
        && request.resource.data.bankIncome is number
        && request.resource.data.bankIncome >= 0
        && request.resource.data.totalItemsSold is int
        && request.resource.data.totalItemsSold >= 0
        && (!("durationDays" in request.resource.data)
          || (request.resource.data.durationDays is int && request.resource.data.durationDays > 0))
        && (!("closedAt" in request.resource.data)
          || (request.resource.data.closedAt == request.time && request.resource.data.status == "closed"))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner();
    }

    match /inventory/{productId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "marketId", "productId", "variantId", "color", "sku", "name", "category", "imageBase64", "price",
          "unitCost", "totalQty", "soldQty", "notes", "updatedAt"
        ])
        && request.resource.data.marketId is string
        && marketIsOpen(request.resource.data.marketId)
        && (!("productId" in request.resource.data) || request.resource.data.productId is string)
        && (!("variantId" in request.resource.data) || request.resource.data.variantId is string)
        && (!("color" in request.resource.data) || request.resource.data.color is string)
        && existsAfter(/databases/$(database)/documents/events/$(request.resource.data.marketId))
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.imageBase64 is string
        && request.resource.data.price is number
        && request.resource.data.unitCost is number
        && request.resource.data.totalQty is int
        && request.resource.data.soldQty is int
        && request.resource.data.soldQty >= 0
        && request.resource.data.soldQty <= request.resource.data.totalQty
        && request.resource.data.notes is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /materials/{materialId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "name", "distributor", "price", "unit", "quantity", "usedQuantity", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.distributor is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.unit in ["pcs", "m", "cm"]
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && (request.resource.data.unit != "pcs" || request.resource.data.quantity is int)
        && request.resource.data.usedQuantity is number
        && request.resource.data.usedQuantity >= 0
        && request.resource.data.usedQuantity <= request.resource.data.quantity
        && (request.resource.data.unit != "pcs" || request.resource.data.usedQuantity is int)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "name", "distributor", "price", "unit", "quantity", "usedQuantity", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.distributor is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.unit in ["pcs", "m", "cm"]
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && (request.resource.data.unit != "pcs" || request.resource.data.quantity is int)
        && request.resource.data.usedQuantity is number
        && request.resource.data.usedQuantity >= 0
        && request.resource.data.usedQuantity <= request.resource.data.quantity
        && (request.resource.data.unit != "pcs" || request.resource.data.usedQuantity is int)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /products/{productId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "sku", "name", "category", "imageBase64", "price",
          "unitCost", "notes", "variants", "createdAt", "updatedAt"
        ])
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.imageBase64 is string
        && request.resource.data.price is number
        && request.resource.data.unitCost is number
        && request.resource.data.notes is string
        && (!("variants" in request.resource.data) || validColorVariants(request.resource.data.variants))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "sku", "name", "category", "imageBase64", "price",
          "unitCost", "notes", "variants", "createdAt", "updatedAt"
        ])
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.imageBase64 is string
        && request.resource.data.price is number
        && request.resource.data.unitCost is number
        && request.resource.data.notes is string
        && (!("variants" in request.resource.data) || validColorVariants(request.resource.data.variants))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /categories/{categoryId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(["name", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(["name", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    match /accounting_entries/{entryId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "nrCrt", "dataOperatiunii", "document", "explicatii",
          "incasariNumerar", "incasariBanca", "platiNumerar", "platiBanca",
          "incomeFiscalType", "expenseFiscalType", "deductibleLimitedAmount",
          "sourceOblioInvoiceId", "createdAt", "updatedAt"
        ])
        && request.resource.data.nrCrt is int
        && request.resource.data.nrCrt > 0
        && request.resource.data.dataOperatiunii is string
        && request.resource.data.dataOperatiunii.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.document is string
        && request.resource.data.explicatii is string
        && request.resource.data.incasariNumerar is number
        && request.resource.data.incasariBanca is number
        && request.resource.data.platiNumerar is number
        && request.resource.data.platiBanca is number
        && (!("incomeFiscalType" in request.resource.data)
          || request.resource.data.incomeFiscalType in ["taxable", "nonTaxable", "ownerContribution", "unclassified"])
        && (!("expenseFiscalType" in request.resource.data)
          || request.resource.data.expenseFiscalType in ["deductibleFull", "deductibleLimited", "nonDeductible", "personal", "unclassified"])
        && (!("deductibleLimitedAmount" in request.resource.data)
          || (request.resource.data.deductibleLimitedAmount is number
            && request.resource.data.deductibleLimitedAmount >= 0))
        && (!("sourceOblioInvoiceId" in request.resource.data)
          || request.resource.data.sourceOblioInvoiceId is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "nrCrt", "dataOperatiunii", "document", "explicatii",
          "incasariNumerar", "incasariBanca", "platiNumerar", "platiBanca",
          "incomeFiscalType", "expenseFiscalType", "deductibleLimitedAmount",
          "sourceOblioInvoiceId", "createdAt", "updatedAt"
        ])
        && request.resource.data.nrCrt is int
        && request.resource.data.nrCrt > 0
        && request.resource.data.dataOperatiunii is string
        && request.resource.data.dataOperatiunii.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.document is string
        && request.resource.data.explicatii is string
        && request.resource.data.incasariNumerar is number
        && request.resource.data.incasariBanca is number
        && request.resource.data.platiNumerar is number
        && request.resource.data.platiBanca is number
        && (!("incomeFiscalType" in request.resource.data)
          || request.resource.data.incomeFiscalType in ["taxable", "nonTaxable", "ownerContribution", "unclassified"])
        && (!("expenseFiscalType" in request.resource.data)
          || request.resource.data.expenseFiscalType in ["deductibleFull", "deductibleLimited", "nonDeductible", "personal", "unclassified"])
        && (!("deductibleLimitedAmount" in request.resource.data)
          || (request.resource.data.deductibleLimitedAmount is number
            && request.resource.data.deductibleLimitedAmount >= 0))
        && (!("sourceOblioInvoiceId" in request.resource.data)
          || request.resource.data.sourceOblioInvoiceId is string)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /fiscal_register_imports/{year} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(["year", "rows", "importedAt"])
        && request.resource.data.year == year
        && year.matches("^[0-9]{4}$")
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 1000
        && request.resource.data.importedAt == request.time;
      allow delete: if false;
    }
  }
}
